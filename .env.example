# Flask
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Sellsy CRM (leave blank to fall back to instance/submissions.jsonl)
SELLSY_CLIENT_ID=
SELLSY_CLIENT_SECRET=
# IDs are per Sellsy account. Defaults are for account 207533 (SAS CARAIBES INCENTIVE TRAVEL):
# pipeline "Enquiries pipeline" (34), step "Incoming enquiry" (34), source "Site Internet" (6).
SELLSY_PIPELINE_ID=34
SELLSY_STEP_ID=34
SELLSY_SOURCE_ID=6
# Staff id that owns new website leads (GET /v2/staffs). Blank = the API key's user.
SELLSY_OWNER_ID=

# Email for the three /lets-connect tabs.
# Gmail: turn on 2-Step Verification, then Google Account -> Security ->
# App passwords -> generate one for "Mail". Use that 16-character value as
# MAIL_PASSWORD (not the normal account password). Leave blank and submissions
# are archived to instance/submissions.jsonl instead of being emailed.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your.account@gmail.com
MAIL_PASSWORD=abcdefghijklmnop
MAIL_DEFAULT_SENDER=your.account@gmail.com
INQUIRY_RECIPIENT=niteshupa6@gmail.com

# Scheduling
TEAMS_BOOKING_URL=
WHATSAPP_NUMBER=

# Microsoft Graph mail (Azure -> App registrations). When all four are set this
# is the mail transport and the MAIL_* SMTP settings above are only a fallback.
# The app needs the APPLICATION permission Mail.Send with admin consent; scope it
# to the sender with New-ApplicationAccessPolicy so it cannot read every mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# WhatsApp Business alerts (Meta Business -> WhatsApp -> API Setup).
# Leave blank and alerts are archived to instance/whatsapp_outbox.jsonl.
# WHATSAPP_TEMPLATE is optional but needed for alerts outside the 24-hour
# window: an approved template whose body takes 5 {{n}} placeholders
# (type, reference, name, company, contact).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WhatsApp Business Account id — not used to send; it is how
# scripts/whatsapp_test.py lists templates and how you manage them by API.
WHATSAPP_WABA_ID=
WHATSAPP_TO=
# ci_new_enquiry is the 5-placeholder template created for these alerts.
# Blank = plain text, which Meta only delivers inside the 24-hour window.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US

# Postgres (Supabase) — stores every /lets-connect submission.
# Either paste the full URL (password URL-encoded):
DATABASE_URL=
# ...or fill these four and leave DATABASE_URL blank:
PGHOST=aws-0-ap-southeast-2.pooler.supabase.com   # Session pooler (IPv4). Direct db.<ref>.supabase.co is IPv6-only.
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.lwvpbtonlqelmgycjrfg
PGPASSWORD=

# Supabase Storage for RFP documents (Storage -> S3 Configuration).
# Create the key with "New access key"; the secret is shown once.
SUPABASE_S3_ENDPOINT=https://lwvpbtonlqelmgycjrfg.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-2
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_BUCKET=rfp-uploads

# Site assistant (services/chatbot.py). Blank = offline answers from site content.
ANTHROPIC_API_KEY=

# Visitor tracking: IP -> city/country, once per new visitor. Blank disables it.
GEOIP_URL=http://ip-api.com/json/{ip}?fields=status,country,regionName,city,org,isp

# Admin sign-in (/admin). Both required; blank disables sign-in. Use a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- AI assistant (OpenRouter via LangChain) --------------------------------
# Ask Caraïbes + Project Assistant. Blank = the assistant falls back to the
# Claude/offline answers and the Project Assistant points at /lets-connect.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional: any NON-batch OpenRouter model id. Default google/gemini-3.6-flash.
# Never use a ":batch" model here — those are asynchronous (minutes to 24h
# turnaround) and the chat widget needs a reply while the visitor is waiting;
# chat_model() strips a ":batch" suffix and warns if one slips in anyway.
OPENROUTER_MODEL=
# Optional: folder of .pdf/.txt/.md the assistant may answer from. Default ./knowledge
KNOWLEDGE_DIR=

# Website-visitor tracking: force one domain's script while testing off the live
# hosts (e.g. TRACKING_HOST=caraibes-incentive.com). Blank = match the real host.
TRACKING_HOST=
